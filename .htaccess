# Serve pre-compressed JSON. The host's compression layer (brotli) covers
# text/javascript and text/css but NOT application/json, so manifests shipped
# full-size — 1.3MB of uncompressed JSON on a catalog boot over cellular
# (iPhone probe, 2026-07-17). scripts/precompress-json.mjs writes a .json.gz
# sibling for every manifest at build; serve it when the client accepts gzip.
# All guarded so a missing module degrades to the plain .json, never a 500.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{REQUEST_FILENAME}.gz -f
  RewriteRule ^(.+)\.json$ $1.json.gz [L]
</IfModule>

<IfModule mod_headers.c>
  # The .gz is really JSON, gzip-encoded — tell the browser both.
  <FilesMatch "\.json\.gz$">
    Header set Content-Encoding gzip
    Header set Content-Type application/json
    Header append Vary Accept-Encoding
  </FilesMatch>
</IfModule>

# mod_deflate (if this host ever activates it) — belt to the pre-compressed
# braces above; also covers html/css/svg.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json text/html text/css application/javascript image/svg+xml
</IfModule>

# Never serve a stale app: browsers must revalidate JS and JSON on each
# load (cheap 304s when unchanged). Found the hard way — a phone silently
# tested yesterday's bundle (C.2). The .gz variants revalidate too.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.json\.gz$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Q5 (0c), applied to what is SAFE TODAY and no further.
#
# The elegance audit's Q5 asks for `max-age` on chapter files — every re-read
# chapter going from RTT+304 to zero. That win is real and it is NOT TAKEN
# HERE, deliberately: **the corpus is served from unversioned paths.** A data
# push replaces `chapters/GEN/001.json` in place, so any max-age longer than
# zero serves YESTERDAY'S VERSES for the rest of its lifetime — the C.2 lesson
# in a worse place, since a stale bundle is visible and a stale verse is not.
# It unlocks the moment H-11 item 4 lands the data version in the URL path,
# which makes corpus files immutable and cacheable forever. Tracked as O-38.
#
# What IS immutable today: pictures. They are content-addressed by name in
# practice — a changed image gets a changed filename — and nothing about a
# deploy rewrites one in place.
<IfModule mod_headers.c>
  <FilesMatch "\.(png|jpe?g|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Reserved cargo (W-9): the corpus JSON is the app's runtime data, but must
# never be indexed by search engines. robots.txt forbids CRAWLING at the
# origin root; this header is the per-directory belt — X-Robots-Tag is
# honored at any depth, unlike a subdirectory robots.txt, so it also covers
# the volume sub-deployments. Harmless to the app's own XHR fetches: only
# crawlers act on it.
<IfModule mod_headers.c>
  <FilesMatch "\.json$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
  <FilesMatch "\.json\.gz$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>
